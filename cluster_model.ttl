    ont:usedSimilarityMeasure data:squaredEuclidean .

data:CentroidClusterModel a ont:ClusteringAlgorithm .

data:centroid0 a ont:FeatureVector ;
    ont:hasFeature "-0.23975164404568033"^^xsd:float,
